{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dev/schemas/stage-materialization-plan.schema.json",
  "title": "Brownfield canonical stage materialization plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generator_version", "repository", "detected", "intended_state",
    "preconditions", "operations", "lock_path", "reasons", "evidence",
    "destructive_removals", "plan_id", "plan_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generator_version": {"const": "DEV-BCSC-B/1"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_marker", "identity_sha256"],
      "properties": {
        "root_marker": {"const": "resolved-project-root-v1"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "detected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification", "route", "stage_selector", "issues", "legacy_sources", "projection"
      ],
      "properties": {
        "classification": {"enum": ["legacy", "mixed"]},
        "route": {"const": "migration_required"},
        "stage_selector": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "issues": {"type": "array", "maxItems": 0},
        "legacy_sources": {"$ref": "#/$defs/legacy_sources"},
        "projection": {"$ref": "#/$defs/projection"}
      }
    },
    "intended_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_selector", "projection", "manifest"],
      "properties": {
        "stage_selector": {"$ref": "#/$defs/id"},
        "projection": {"$ref": "#/$defs/projection"},
        "manifest": {"$ref": "stage-compatibility.schema.json"}
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/precondition"}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path", "before_sha256", "after_sha256", "content"],
        "properties": {
          "op": {"const": "write"},
          "path": {"const": "docs/STAGES.md"},
          "before_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "after_sha256": {"$ref": "#/$defs/sha256"},
          "content": {"type": "string", "maxLength": 500000}
        }
      }
    },
    "lock_path": {"const": ".stage-compatibility.lock"},
    "reasons": {"$ref": "#/$defs/bounded_strings"},
    "evidence": {"$ref": "#/$defs/bounded_strings"},
    "destructive_removals": {"const": false},
    "plan_id": {"type": "string", "pattern": "^bsc-[0-9a-f]{16}$"},
    "plan_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "bounded_strings": {
      "type": "array",
      "maxItems": 128,
      "items": {"type": "string", "maxLength": 1024}
    },
    "legacy_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "disposition"],
        "properties": {
          "path": {"enum": ["docs/AI_PLAN.md", "docs/AI_STATUS.md"]},
          "sha256": {"$ref": "#/$defs/sha256"},
          "disposition": {"const": "retained"}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_stage", "master_id", "status", "next_selector",
        "blockers", "checkpoint", "evidence"
      ],
      "properties": {
        "current_stage": {"$ref": "#/$defs/id"},
        "master_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "status": {
          "enum": [
            "planned", "queued", "ready", "running", "in_progress", "blocked", "scaffolded",
            "implemented", "partial", "implemented_unverified", "completed", "verified",
            "unavailable", "unknown"
          ]
        },
        "next_selector": {"$ref": "#/$defs/id"},
        "blockers": {"$ref": "#/$defs/bounded_strings"},
        "checkpoint": {
          "oneOf": [{"type": "string", "maxLength": 1024}, {"type": "null"}]
        },
        "evidence": {"$ref": "#/$defs/bounded_strings"}
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "type", "sha256"],
      "properties": {
        "path": {"enum": ["docs/STAGES.md", "prompts/STAGES.md", "docs/AI_PLAN.md", "docs/AI_STATUS.md"]},
        "exists": {"type": "boolean"},
        "type": {"enum": ["regular", "absent"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
