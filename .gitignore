# `~/.codex` одновременно является runtime-каталогом Codex и Git-корнем ДЕВ.
# По умолчанию не отслеживать host-managed state, credentials, sessions и cache.
/*

# Канонические файлы и каталоги ДЕВ.
!/.gitignore
!/AGENTS.md
!/DESIGN.md
!/MANIFEST.txt
!/QUICKSTART.md
!/README.md
!/install-global.ps1
!/install-project.ps1
!/config.ai-dev-team.recommended.toml
!/hooks.json
!/agents/
!/backlog/
!/docs/
!/hooks/
!/presets/
!/rules/
!/skills/
!/specs/
!/templates/
!/tools/

# Runtime rules Codex не являются частью ДЕВ.
/rules/default.rules

# В `skills/` Codex также устанавливает system/plugin Skills. Версионируются
# только Skills ДЕВ, перечисленные явно.
/skills/*
!/skills/bootstrap-project-framework/
!/skills/bootstrap-project-framework/**
!/skills/dev-karkas/
!/skills/dev-karkas/**
!/skills/explain-change/
!/skills/explain-change/**
!/skills/fix-bug/
!/skills/fix-bug/**
!/skills/implement-stage/
!/skills/implement-stage/**
!/skills/plan-stage/
!/skills/plan-stage/**
!/skills/resume-project/
!/skills/resume-project/**
!/skills/review-change/
!/skills/review-change/**

# Локальные секреты, caches и служебные файлы внутри управляемых каталогов.
**/.env
**/.env.*
!**/.env.example
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
