# Canonical DEV source repository is allowlisted by top-level source areas.
# Runtime state belongs only to the separate installed `~/.codex` layer.
/*

# Канонические файлы и каталоги ДЕВ.
!/.gitignore
!/AGENTS.md
!/MANIFEST.txt
!/QUICKSTART.md
!/README.md
!/install-global.ps1
!/install-global.sh
!/config.ai-dev-team.recommended.toml
!/hooks.json
!/agents/
!/docs/
!/hooks/
!/prompts/
!/presets/
!/rules/
!/schemas/
!/skill-sources/
!/specs/
!/templates/
!/tools/
!/.github/

# Host/runtime rules are not canonical DEV source artifacts.
/rules/default.rules

# Versioned source глобальных Skills. Активная runtime-проекция устанавливается
# в `~/.agents/skills`; host-managed `~/.codex/skills` остаётся вне Git.
!/skill-sources/**

# Локальные секреты, caches и служебные файлы внутри source tree.
**/.env
**/.env.*
!**/.env.example
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

# Secrets and local credentials inside otherwise versioned DEV directories.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/auth.json
**/credentials.json
**/credentials.*.json
**/*-credentials.json
**/.secrets/
**/secrets.local.*

# Downloaded dependencies, generated builds and test/tool caches.
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.yarn/cache/
**/.gradle/
**/.dart_tool/
**/target/
**/build/
**/dist/
**/out/
**/.next/
**/.svelte-kit/
**/.astro/
**/coverage/
**/.coverage
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/downloads/

# Local databases, logs, temporary/editor files and downloaded archives.
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*.swo
**/*.zip
**/*.7z
**/*.tar
**/*.tar.gz
**/*.tgz
