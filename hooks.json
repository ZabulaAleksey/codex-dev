{
  "description": "Hooks жизненного цикла AI Dev Team: загружают компактное состояние проекта, проверяют приватность Git identity и блокируют небольшой набор разрушительных команд.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/session_context.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\session_context.py\"",
            "statusMessage": "Загрузка состояния AI-проекта",
            "additionalContextLimit": 3000,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/tools/check_git_identity.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\tools\\check_git_identity.py\"",
            "statusMessage": "Проверка приватности Git identity",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/session_context.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\session_context.py\"",
            "statusMessage": "Загрузка контекста проекта для субагента",
            "additionalContextLimit": 2000,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/guard_destructive.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\guard_destructive.py\"",
            "statusMessage": "Проверка политики разрушительных команд",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
